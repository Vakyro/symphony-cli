+    fn done_since(&self, run: RunId, plan: &Plan) -> usize {
+        let base = self
+            .plan_done
+            .lock()
+            .ok()
+            .and_then(|m| m.get(&run).copied())
+            .unwrap_or(0);
+        plan.counts().0.saturating_sub(base)
